# Copy to .env only for deployment. For local use run: virtualqueue keys
VQ_MODE=production
PUBLIC_URL=https://queue.your-approved-domain.example
DATABASE_URL=postgresql+psycopg://virtualqueue:REPLACE@private-db.example:5432/virtualqueue?sslmode=verify-full&sslrootcert=/run/secrets/database-ca.crt
ENCRYPTION_KEY=
SIGNING_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_API_AUDIENCE=virtualqueue
TRUST_GATEWAY_URL=
TRUST_GATEWAY_KEY=
TRUST_GATEWAY_CERT=/run/secrets/gateway-client.crt
TRUST_GATEWAY_PRIVATE_KEY=/run/secrets/gateway-client.key
TRUST_GATEWAY_CA=/run/secrets/gateway-ca.crt
# Reference to the deploying organisation's actual approved release record.
# This is an operational gate, not a substitute for assurance.
CLINICAL_RELEASE_ID=
# Optional, requires an authorised Google Maps account and patient location consent.
GOOGLE_ROUTES_KEY=
